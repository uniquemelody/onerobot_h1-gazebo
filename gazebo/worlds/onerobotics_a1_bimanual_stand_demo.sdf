                <topic>/a1_demo/onerobotics_a1_bimanual_stand/joint_l6/cmd_pos</topic>
                <use_velocity_commands>true</use_velocity_commands>
                <cmd_max>0.1</cmd_max>
                <cmd_min>-0.1</cmd_min>
