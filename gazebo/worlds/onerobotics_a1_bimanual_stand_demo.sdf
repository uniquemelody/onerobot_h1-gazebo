                <joint_index>0</joint_index>
                <topic>/a1_demo/onerobotics_a1_bimanual_stand/joint_l7/cmd_pos</topic>
                <use_velocity_commands>true</use_velocity_commands>
                <cmd_max>0.1</cmd_max>
                <cmd_min>-0.1</cmd_min>
                <initial_position>0</initial_position>
            </plugin>
            <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
                <joint_name>joint_r1</joint_name>
                <joint_name>joint_r2</joint_name>
                <joint_name>joint_r3</joint_name>
                <joint_name>joint_r4</joint_name>
                <joint_name>joint_r5</joint_name>
                <joint_name>joint_r6</joint_name>
                <joint_name>joint_r7</joint_name>
                <joint_name>joint_l1</joint_name>
                <joint_name>joint_l2</joint_name>
                <joint_name>joint_l3</joint_name>
                <joint_name>joint_l4</joint_name>
